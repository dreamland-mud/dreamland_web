<html lang="ru">
<head>
    <%- include('head'); %>
    <title>DreamLand MUD - Мир Грёз, Самурайские истории</title>
    <link type="text/css" rel="stylesheet" href="css/terminal.css?2"/>
</head>

<body>
    <%- include('header'); %>
    <%- include('hero', {breadcrumb: 'Samurai', title: 'Самурайские истории'}) %>

    <div id="links" class="section">
        <div class="container">
            <div class="row">                                        
                <div id="main" class="col-md-12">
                    <div class="section-header">
                        <h2 class="h1">Сказки, истории и легенды Мира Грёз</h2>
                        <p class="lead">Содержание:
                            <ul class="list-group" style="width: 400px;">
                                <li class="list-group-item"><a href="/ru/stories.html"><div class="h4">Истории новой эпохи</div></a></li>
                                <li class="list-group-item"><a href="/ru/samurai.html"><div class="h4">Самурайские истории</div></a></li>
                                <li class="list-group-item"><a href="/ru/legends.html"><div class="h4">Древние легенды Второй Эпохи</div></a></li>
                            </ul>
                        </p>
                        <br/>
                        <h2>Самурайские истории</h2>
                        <p class="lead">Здесь собраны все выпуски историй о самураях, которые Миямото публиковал в Четвертую Эпоху (в 2004-2005 годах).</p>
                    </div><!-- section-header -->

<% for (let i = 0; i < notes.length; i++) { %>
<% let note = notes[i]; %>
<pre class="terminal">
    <div><span class="story-author">[<%= note.date %>] <%=note.from %>: </span><span class="story-title"><%- note.subject %></span></div>
    <div class="story-text"><%- note.text %></div>
</pre>
<% } %>
                </div><!-- main -->
            </div><!-- row -->
        </div><!-- container -->
    </div><!-- section -->
<%- include('footer'); %>
<%- include('foot'); %>
</body>
</html>
